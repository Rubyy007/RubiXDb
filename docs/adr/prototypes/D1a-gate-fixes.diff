+/// Which WAL sequence numbers are accounted for (applied to a MemTable, or known to need no apply). `contiguous()` is the
+/// highest `s` such that every seq `<= s` is accounted for.
+#[derive(Debug)]
+struct ApplyTracker {
+    inner: Mutex<TrackerInner>,
+}
+
+#[derive(Debug)]
+struct TrackerInner {
+    contiguous: u64,
+    above: BTreeSet<u64>,
+}
+
+impl ApplyTracker {
+    fn new(contiguous: u64) -> Self {
+        ApplyTracker {
+            inner: Mutex::new(TrackerInner {
+                contiguous,
+                above: BTreeSet::new(),
+            }),
+        }
+    }
+
+    fn account(&self, seq: u64) {
+        let mut g = self.inner.lock().unwrap_or_else(|p| p.into_inner());
+        if seq <= g.contiguous {
+            return;
+        }
+        g.above.insert(seq);
+        loop {
+            let next = g.contiguous + 1;
+            if g.above.remove(&next) {
+                g.contiguous = next;
+            } else {
+                break;
+            }
+        }
+    }
+
+    fn contiguous(&self) -> u64 {
+        self.inner.lock().unwrap_or_else(|p| p.into_inner()).contiguous
+    }
+}
